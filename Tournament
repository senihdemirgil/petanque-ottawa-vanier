 const pairs=pairBacktrack(order,historySet());const matches=[];let terrain=1;
 pairs.forEach(([a,b])=>{matches.push({id:uid(),a,b,scoreA:null,scoreB:null,terrain});terrain=terrain>=state.settings.terrains?1:terrain+1});
