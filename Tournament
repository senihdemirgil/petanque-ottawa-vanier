  while(S.length+P.length>=2){let m=[];if(S.length&&P.length)m=[S.shift(),P.shift()];else{const src=S.length?S:P;m=[src.shift(),src.shift()].filter(Boolean)}if(m.length===2)teams.push(makeTeam(m));else left.push(...m.map(x=>x.id))}
